
import React, { useState } from "react";

export default function App() {
  const [reports, setReports] = useState([]);
  const [form, setForm] = useState({
    name: "",
    location: "",
    disaster: "Flood",
    description: ""
  });

  const disasters = [
    { name: "Flood", icon: "🌊", color: "#dbeafe",
      details: "Move to higher ground. Avoid flooded roads." },
    { name: "Earthquake", icon: "🌍", color: "#fef3c7",
      details: "Drop, cover and hold. Stay away from windows." },
    { name: "Cyclone", icon: "🌀", color: "#ede9fe",
      details: "Stay indoors and follow official warnings." },
    { name: "Fire", icon: "🔥", color: "#fee2e2",
      details: "Evacuate immediately and call emergency services." }
  ];

  const contacts = [
    { service: "Emergency Helpline", number: "112" },
    { service: "Fire Department", number: "101" },
    { service: "Ambulance", number: "108" },
    { service: "Disaster Management", number: "1070" }
  ];

  const safetyTips = [
    "Keep an emergency first-aid kit ready.",
    "Store drinking water and essential food.",
    "Keep important documents in a safe place.",
    "Follow government emergency announcements.",
    "Avoid spreading unverified information.",
    "Move to a safe location during disasters."
  ];

  const handleChange = (e) => {
    setForm({ ...form, [e.target.name]: e.target.value });
  };

  const handleSubmit = (e) => {
    e.preventDefault();

    if (!form.name || !form.location || !form.description) {
      alert("Please fill all the fields");
      return;
    }

    setReports([...reports, { ...form, id: Date.now() }]);

    alert("Disaster report submitted successfully!");

    setForm({
      name: "",
      location: "",
      disaster: "Flood",
      description: ""
    });
  };

  const styles = {
    background: "#f1f5f9",
    minHeight: "100vh",
    fontFamily: "Arial, sans-serif",
    color: "#1e293b"
  };

  const card = {
    background: "white",
    padding: "20px",
    borderRadius: "12px",
    boxShadow: "0 3px 12px rgba(0,0,0,0.08)"
  };

  const button = {
    background: "#dc2626",
    color: "white",
    padding: "12px 20px",
    border: "none",
    borderRadius: "7px",
    cursor: "pointer",
    fontWeight: "bold"
  };

  return (
    <div style={styles}>

      {/* HEADER */}
      <header style={{
        background: "#0f172a",
        color: "white",
        padding: "22px",
        textAlign: "center"
      }}>
        <h1>🚨 Disaster Management System</h1>
        <p>Prepare • Protect • Respond • Recover</p>
      </header>

      {/* NAVIGATION */}
      <nav style={{
        background: "#1e293b",
        padding: "15px",
        display: "flex",
        justifyContent: "center",
        flexWrap: "wrap",
        gap: "25px"
      }}>
        {["Home", "Disasters", "Emergency", "Report", "Safety"].map(item => (
          <a href={"#" + item.toLowerCase()}
            key={item}
            style={{ color: "white", textDecoration: "none" }}>
            {item}
          </a>
        ))}
      </nav>

      <main style={{ padding: "25px", maxWidth: "1200px", margin: "auto" }}>

        {/* HOME */}
        <section id="home" style={{
          background: "linear-gradient(120deg,#1d4ed8,#0f172a)",
          color: "white",
          padding: "45px 25px",
          borderRadius: "15px",
          marginBottom: "30px",
          textAlign: "center"
        }}>
          <h2>Welcome to Disaster Management Portal</h2>
          <p>
            Get disaster alerts, emergency contacts, safety instructions
            and report disaster situations.
          </p>
          <a href="#report">
            <button style={button}>Report an Emergency</button>
          </a>
        </section>

        {/* DASHBOARD */}
        <h2>📊 Dashboard Overview</h2>

        <div style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit,minmax(200px,1fr))",
          gap: "18px",
          marginBottom: "35px"
        }}>
          {[
            ["Disaster Types", "4", "🌪️"],
            ["Emergency Numbers", "4", "📞"],
            ["Reports Submitted", reports.length, "📋"],
            ["Safety Guidelines", "6", "🛡️"]
          ].map(([title, value, icon]) => (
            <div style={card} key={title}>
              <h2>{icon}</h2>
              <h2 style={{ color: "#2563eb" }}>{value}</h2>
              <p>{title}</p>
            </div>
          ))}
        </div>

        {/* DISASTERS */}
        <section id="disasters">
          <h2>🌪️ Types of Disasters</h2>

          <div style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit,minmax(220px,1fr))",
            gap: "18px"
          }}>
            {disasters.map(d => (
              <div key={d.name}
                style={{ ...card, background: d.color }}>
                <h1>{d.icon}</h1>
                <h3>{d.name}</h3>
                <p>{d.details}</p>
              </div>
            ))}
          </div>
        </section>

        {/* EMERGENCY CONTACTS */}
        <section id="emergency" style={{ marginTop: "40px" }}>
          <h2>📞 Emergency Helpline Numbers</h2>

          <div style={card}>
            {contacts.map(c => (
              <div key={c.service} style={{
                display: "flex",
                justifyContent: "space-between",
                borderBottom: "1px solid #ddd",
                padding: "14px"
              }}>
                <strong>{c.service}</strong>
                <a href={"tel:" + c.number}
                  style={{ color: "#dc2626", fontWeight: "bold" }}>
                  {c.number}
                </a>
              </div>
            ))}
          </div>
          <p style={{ color: "#b91c1c" }}>
            Note: Verify local emergency numbers and availability.
            Call 112 for emergency assistance in India.
          </p>
        </section>

        {/* REPORT FORM */}
        <section id="report" style={{ marginTop: "40px" }}>
          <h2>📝 Report a Disaster</h2>

          <form onSubmit={handleSubmit} style={{
            ...card,
            display: "grid",
            gap: "15px"
          }}>
            <label>Name</label>
            <input
              name="name"
              value={form.name}
              onChange={handleChange}
              placeholder="Enter your name"
              style={inputStyle}
            />

            <label>Location</label>
            <input
              name="location"
              value={form.location}
              onChange={handleChange}
              placeholder="Enter disaster location"
              style={inputStyle}
            />

            <label>Disaster Type</label>
            <select
              name="disaster"
              value={form.disaster}
              onChange={handleChange}
              style={inputStyle}
            >
              {disasters.map(d => (
                <option key={d.name}>{d.name}</option>
              ))}
            </select>

            <label>Description</label>
            <textarea
              name="description"
              value={form.description}
              onChange={handleChange}
              placeholder="Describe the emergency..."
              rows="4"
              style={inputStyle}
            />

            <button type="submit" style={button}>
              Submit Report
            </button>
          </form>
        </section>

        {/* REPORT LIST */}
        <section style={{ marginTop: "35px" }}>
          <h2>📋 Submitted Reports</h2>

          {reports.length === 0 ? (
            <p>No reports submitted yet.</p>
          ) : (
            reports.map(r => (
              <div key={r.id} style={{ ...card, marginBottom: "12px" }}>
                <h3>{r.disaster}</h3>
                <p><b>Name:</b> {r.name}</p>
                <p><b>Location:</b> {r.location}</p>
                <p><b>Description:</b> {r.description}</p>
              </div>
            ))
          )}
        </section>

        {/* SAFETY TIPS */}
        <section id="safety" style={{ marginTop: "40px" }}>
          <h2>🛡️ Disaster Safety Guidelines</h2>

          <div style={card}>
            {safetyTips.map((tip, index) => (
              <p key={index}>✅ {tip}</p>
            ))}
          </div>
        </section>

      </main>

      {/* FOOTER */}
      <footer style={{
        background: "#0f172a",
        color: "white",
        textAlign: "center",
        padding: "22px",
        marginTop: "40px"
      }}>
        <h3>Disaster Management System</h3>
        <p>Building a Safer and Prepared Society</p>
        <p>© 2026 Disaster Management Project</p>
      </footer>

    </div>
  );
}

const inputStyle = {
  padding: "12px",
  border: "1px solid #cbd5e1",
  borderRadius: "7px",
  width: "100%",
  boxSizing: "border-box",
  fontSize: "15px"
};
